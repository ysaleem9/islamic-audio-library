# ===========================================
# 1. إعدادات لوحة التحكم (مهم تغييرها قبل النشر)
# ===========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
AUTH_SECRET=replace-with-a-long-random-secret-key-at-least-32-chars

# ===========================================
# 2. إعدادات Internet Archive للرفع المباشر المجاني (اختياري)
# احصل على المفاتيح مجاناً من: https://archive.org/account/s3.php
# ===========================================
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=
# بادئة لاسم العناصر على أرشيف الإنترنت (حروف إنجليزية وأرقام وشرطة فقط)
ARCHIVE_IDENTIFIER_PREFIX=sheikh-lessons

# ===========================================
# 3. قاعدة بيانات Supabase المجانية (اختياري للإنتاج على Vercel)
# بدون هذه المتغيرات يعمل الموقع تلقائياً بملف بيانات محلي data/db.json
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
